#version 450
// TEMP (lab, REIMS_VGPU_LAB_PRESENT_FG): the frame at `phase` between two guest frames, from the hardware optical
// flow between them (VK_NV_optical_flow, one vector pair per 4x4 cell, S10.5 fixed point read as integers).
//
// `fwd` moves each pixel of `prev` to its place in `cur`; `bwd` moves each pixel of `cur` back to `prev`. With a
// motion (f, b) the pixel samples `prev` at `here + phase * b` and `cur` at `here + (1 - phase) * f` and blends them.
//
// The flow is not trusted blindly: over still content its vectors in flat areas are arbitrary, and a warp along them
// drags text over white and white over text (b914a dumps). Per cell, "no motion" replaces the cell's flow when the two
// frames agree better without motion over the 5x5 cells (20x20 pixels) around it - summed over the window, not per
// pixel: per pixel, no motion "matches" in the white gaps between moving lines of text and erases them. Offline, on a
// scroll pair with its true middle frame (E:/tmp-c/fg): 43.8 dB vs 44.5 for the plain warp; on a still pair with that
// pair's flow: 65.0 dB vs 25.7. Where the flow pair is inconsistent (something appeared or vanished) the warped
// previous frame wins over a ghost of both.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D prev_frame;
layout(binding = 1) uniform sampler2D cur_frame;
layout(binding = 2) uniform isampler2D fwd;
layout(binding = 3) uniform isampler2D bwd;
layout(binding = 4, rgba8) uniform writeonly image2D mid;

layout(push_constant) uniform Push {
    ivec2 size;   // frame size in pixels
    int grid;     // flow grid cell size in pixels (4: the workgroup holds 4x4 cells)
    float phase;  // 0 = prev, 1 = cur
} pc;

// The workgroup's 4x4 cells plus two cells around: 8x8 cells, each summed by four invocations (one pixel row each).
shared float part_flow[256];
shared float part_still[256];

void main() {
    vec2 inv = 1.0 / vec2(pc.size);
    ivec2 cells = textureSize(fwd, 0);
    uint li = gl_LocalInvocationIndex;
    // Step 1: this invocation's row of one cell of the 8x8 window.
    {
        ivec2 local_cell = ivec2(int(li / 4u) % 8, int(li / 4u) / 8);
        ivec2 cell = ivec2(gl_WorkGroupID.xy) * 4 - 2 + local_cell;
        ivec2 fcell = clamp(cell, ivec2(0), cells - 1);
        vec2 f = vec2(texelFetch(fwd, fcell, 0).xy) / 32.0;
        vec2 b = vec2(texelFetch(bwd, fcell, 0).xy) / 32.0;
        int y = cell.y * pc.grid + int(li % 4u);
        float cf = 0.0;
        float cs = 0.0;
        if (y >= 0 && y < pc.size.y) {
            for (int i = 0; i < pc.grid; i++) {
                int x = cell.x * pc.grid + i;
                if (x < 0 || x >= pc.size.x) {
                    continue;
                }
                vec2 here = vec2(x, y) + 0.5;
                vec3 a = texture(prev_frame, (here + pc.phase * b) * inv).rgb;
                vec3 c = texture(cur_frame, (here + (1.0 - pc.phase) * f) * inv).rgb;
                vec3 d = abs(a - c);
                cf += d.r + d.g + d.b;
                vec3 a0 = texture(prev_frame, here * inv).rgb;
                vec3 c0 = texture(cur_frame, here * inv).rgb;
                vec3 d0 = abs(a0 - c0);
                cs += d0.r + d0.g + d0.b;
            }
        }
        part_flow[li] = cf;
        part_still[li] = cs;
    }
    barrier();
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) {
        return;
    }
    // Step 2: the 5x5 cells around this pixel's cell.
    ivec2 mine = ivec2(gl_LocalInvocationID.xy) / 4 + 2;
    float sum_flow = 0.0;
    float sum_still = 0.0;
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            int k = ((mine.y + dy) * 8 + (mine.x + dx)) * 4;
            sum_flow += part_flow[k] + part_flow[k + 1] + part_flow[k + 2] + part_flow[k + 3];
            sum_still += part_still[k] + part_still[k + 1] + part_still[k + 2] + part_still[k + 3];
        }
    }
    vec2 here = vec2(p) + 0.5;
    vec4 outc;
    if (sum_still < sum_flow) {
        outc = mix(texture(prev_frame, here * inv), texture(cur_frame, here * inv), pc.phase);
    } else {
        ivec2 cell = min(p / pc.grid, cells - 1);
        vec2 f = vec2(texelFetch(fwd, cell, 0).xy) / 32.0;
        vec2 b = vec2(texelFetch(bwd, cell, 0).xy) / 32.0;
        vec4 a = texture(prev_frame, (here + pc.phase * b) * inv);
        vec4 c = texture(cur_frame, (here + (1.0 - pc.phase) * f) * inv);
        float inconsistent = smoothstep(2.0, 8.0, length(f + b));
        outc = mix(mix(a, c, pc.phase), pc.phase < 0.5 ? a : c, inconsistent);
    }
    imageStore(mid, p, outc);
}
