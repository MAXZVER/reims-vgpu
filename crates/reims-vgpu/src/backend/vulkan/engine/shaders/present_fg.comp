#version 450
// TEMP (lab, REIMS_VGPU_LAB_PRESENT_FG): the frame at `phase` between two guest frames, from the hardware optical
// flow between them (VK_NV_optical_flow, one vector pair per grid cell, S10.5 fixed point read as integers).
//
// `fwd` moves each pixel of `prev` to its place in `cur`; `bwd` moves each pixel of `cur` back to `prev`. A motion
// candidate (f, b) samples `prev` at `here + phase * b` and `cur` at `here + (1 - phase) * f` and blends the two.
// The flow alone is not trusted: in flat areas (white page, flat UI) its vectors are arbitrary, and a wrong one
// drags text across white or white across text (b914a dumps). So every pixel tries candidates - no motion, its own
// cell's flow and the four neighbouring cells' - and keeps the one under which the two frames agree best over a
// small cross-shaped patch. Unchanged content therefore comes through exactly (no motion matches perfectly); where no
// candidate agrees and the flow is inconsistent (something appeared or vanished), the nearer frame wins.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D prev_frame;
layout(binding = 1) uniform sampler2D cur_frame;
layout(binding = 2) uniform isampler2D fwd;
layout(binding = 3) uniform isampler2D bwd;
layout(binding = 4, rgba8) uniform writeonly image2D mid;

layout(push_constant) uniform Push {
    ivec2 size;   // frame size in pixels
    int grid;     // flow grid cell size in pixels
    float phase;  // 0 = prev, 1 = cur
} pc;

vec2 inv;

float mismatch(vec2 here, vec2 f, vec2 b) {
    const vec2 taps[5] = vec2[5](vec2(0.0, 0.0), vec2(-2.0, 0.0), vec2(2.0, 0.0), vec2(0.0, -2.0), vec2(0.0, 2.0));
    float cost = 0.0;
    for (int i = 0; i < 5; i++) {
        vec2 o = taps[i];
        vec3 a = texture(prev_frame, (here + o + pc.phase * b) * inv).rgb;
        vec3 c = texture(cur_frame, (here + o + (1.0 - pc.phase) * f) * inv).rgb;
        vec3 d = abs(a - c);
        cost += d.r + d.g + d.b;
    }
    return cost;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) {
        return;
    }
    inv = 1.0 / vec2(pc.size);
    vec2 here = vec2(p) + 0.5;
    ivec2 cell = p / pc.grid;
    ivec2 cells = textureSize(fwd, 0);
    const ivec2 near[5] = ivec2[5](ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
    // No motion first: it wins ties, so unchanged content is exact.
    vec2 best_f = vec2(0.0);
    vec2 best_b = vec2(0.0);
    float best = mismatch(here, best_f, best_b);
    if (best > 0.0) {
        for (int i = 0; i < 5; i++) {
            ivec2 c = clamp(cell + near[i], ivec2(0), cells - 1);
            vec2 f = vec2(texelFetch(fwd, c, 0).xy) / 32.0;
            vec2 b = vec2(texelFetch(bwd, c, 0).xy) / 32.0;
            float m = mismatch(here, f, b);
            if (m < best) {
                best = m;
                best_f = f;
                best_b = b;
            }
        }
    }
    vec4 a = texture(prev_frame, (here + pc.phase * best_b) * inv);
    vec4 c = texture(cur_frame, (here + (1.0 - pc.phase) * best_f) * inv);
    vec4 blended = mix(a, c, pc.phase);
    // Nothing matched (about 0.1 per channel over the patch) and the vectors disagree: an appearing or vanishing
    // edge - take the nearer frame where the pixel is, rather than a ghost of both.
    float occluded = smoothstep(1.5, 4.0, best) * smoothstep(2.0, 8.0, length(best_f + best_b));
    vec4 nearer = pc.phase < 0.5 ? texture(prev_frame, here * inv) : texture(cur_frame, here * inv);
    imageStore(mid, p, mix(blended, nearer, occluded));
}
