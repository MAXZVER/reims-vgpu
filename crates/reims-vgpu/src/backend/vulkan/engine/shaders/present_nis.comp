#version 450
// The host window's scaled present through NVIDIA Image Scaling (NVScaler, NIS
// SDK v1.0.3, MIT licence, Copyright (c) 2022 NVIDIA CORPORATION & AFFILIATES;
// NIS_Scaler.h beside this file is the SDK's, unchanged): a 6-tap scaler with
// four directional filters and adaptive sharpening, NVIDIA's spatial
// counterpart of FSR 1.0. Mish 2026-10-19: "качай NIS, посмотрим как он будет
// работать" - an alternative to EASU (+RCAS) on the same 4096x1728 -> 5K path.
//
// The SDK's GLSL main, with the constants in push constants (112 bytes) instead
// of a uniform buffer and the output declared rgba8, so no
// shaderStorageImageWriteWithoutFormat is needed. Writes the visible part's
// size into `out_texture` (the presenter draws it into the window after).
#extension GL_GOOGLE_include_directive : enable

#define NIS_GLSL 1
#define NIS_SCALER 1
#define NIS_BLOCK_WIDTH 32
#define NIS_BLOCK_HEIGHT 24
#define NIS_THREAD_GROUP_SIZE 128
#define NIS_USE_HALF_PRECISION 0
#define NIS_CLAMP_OUTPUT 1

layout(push_constant) uniform NisConfig
{
    float kDetectRatio;
    float kDetectThres;
    float kMinContrastRatio;
    float kRatioNorm;

    float kContrastBoost;
    float kEps;
    float kSharpStartY;
    float kSharpScaleY;

    float kSharpStrengthMin;
    float kSharpStrengthScale;
    float kSharpLimitMin;
    float kSharpLimitScale;

    float kScaleX;
    float kScaleY;

    float kDstNormX;
    float kDstNormY;
    float kSrcNormX;
    float kSrcNormY;

    uint kInputViewportOriginX;
    uint kInputViewportOriginY;
    uint kInputViewportWidth;
    uint kInputViewportHeight;

    uint kOutputViewportOriginX;
    uint kOutputViewportOriginY;
    uint kOutputViewportWidth;
    uint kOutputViewportHeight;
};

layout(set = 0, binding = 1) uniform sampler samplerLinearClamp;
layout(set = 0, binding = 2) uniform texture2D in_texture;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D out_texture;
layout(set = 0, binding = 4) uniform texture2D coef_scaler;
layout(set = 0, binding = 5) uniform texture2D coef_usm;

#include "NIS_Scaler.h"

layout(local_size_x = NIS_THREAD_GROUP_SIZE) in;
void main()
{
    NVScaler(gl_WorkGroupID.xy, gl_LocalInvocationID.x);
}
