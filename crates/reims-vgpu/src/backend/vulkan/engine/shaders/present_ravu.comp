#version 450
// TEMP (lab, REIMS_VGPU_LAB_PRESENT_RAVU): the guest frame upscaled into `mid` by RAVU-Zoom-AR r3 (bjin/mpv-prescalers,
// LGPL-3.0-or-later; RAISR-style: the structure tensor of a 4x4 luma window picks one of 288 trained 6x6 kernels for
// the pixel's subpixel phase, then anti-ringing toward a soft min/max of the centre ring). Its two weight tables are
// read from the mpv hook at run time (present_ravu.rs) and bound at 1 and 2.
//
// Generated by lab/tools/ravubench/gen_tiled2.py (with FLAT_SKIP), the fastest of the variants timed there - 16x16
// output tiles: the tile's source texels, luma and luma gradients loaded once into shared memory; the filter choice
// (it depends only on a pixel's base texel) made once per base texel; every index constant (an array or vector indexed
// by a loop variable can land in local memory); a window of one colour stored without the filter (exact). RTX 4060,
// 4096x1728 -> 5120x2160: 4.4-5.7 ms against 9.4-9.7 ms for the per-pixel form. Upscaling only: the shared tile
// holds the 6x6 windows of at most 18 base texels a side (scale <= 1.0625).
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1) uniform sampler2D lut;
layout(set = 0, binding = 2) uniform sampler2D lut_ar;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform Push { vec2 size; vec2 out_size; } pc;
layout(local_size_x = 16, local_size_y = 16) in;

const int TILE = 24;
const int BASES = 18;
shared vec3 rgb[TILE][TILE];
shared float luma[TILE][TILE];
// (3-point x, 5-point x, 3-point y, 5-point y) luma gradients at each tile texel.
shared vec4 grad[TILE][TILE];
shared float row_of[BASES][BASES];

const vec3 PRIMARY = vec3(0.2126, 0.7152, 0.0722);

ivec2 baseOf(ivec2 o) {
    return ivec2(floor((vec2(o) + 0.5) * pc.size / pc.out_size - 0.5));
}

float Lc(int x, int y) {
    return luma[clamp(y, 0, TILE - 1)][clamp(x, 0, TILE - 1)];
}

void main() {
    ivec2 tile0 = ivec2(gl_WorkGroupID.xy) * 16;
    ivec2 b0 = baseOf(tile0);
    ivec2 b1 = baseOf(tile0 + 15);
    ivec2 org = b0 - 2;
    ivec2 hi = ivec2(pc.size) - 1;
    int lid = int(gl_LocalInvocationIndex);
    for (int k = lid; k < TILE * TILE; k += 256) {
        ivec2 t = ivec2(k % TILE, k / TILE);
        vec3 c = texelFetch(src, clamp(org + t, ivec2(0), hi), 0).rgb;
        rgb[t.y][t.x] = c;
        luma[t.y][t.x] = dot(c, PRIMARY);
    }
    barrier();
    for (int k = lid; k < TILE * TILE; k += 256) {
        int x = k % TILE, y = k / TILE;
        float g3x = (Lc(x + 1, y) - Lc(x - 1, y)) / 2.0;
        float g5x = (-Lc(x + 2, y) + 8.0 * Lc(x + 1, y) - 8.0 * Lc(x - 1, y) + Lc(x - 2, y)) / 12.0;
        float g3y = (Lc(x, y + 1) - Lc(x, y - 1)) / 2.0;
        float g5y = (-Lc(x, y + 2) + 8.0 * Lc(x, y + 1) - 8.0 * Lc(x, y - 1) + Lc(x, y - 2)) / 12.0;
        grad[y][x] = vec4(g3x, g5x, g3y, g5y);
    }
    barrier();
    ivec2 nb = b1 - b0 + 1;
    for (int k = lid; k < nb.x * nb.y; k += 256) {
        int tx = k % nb.x, ty = k / nb.x;
        // A window of one colour: every tap is that colour, the weights sum to one and the anti-ringing bounds are
        // that colour too, so the pixel is the colour - marked -1 and stored without the filter.
        vec3 wmin = rgb[ty][tx], wmax = wmin;
        for (int j = 0; j < 6; j++) {
            for (int i = 0; i < 6; i++) {
                vec3 c = rgb[ty + j][tx + i];
                wmin = min(wmin, c);
                wmax = max(wmax, c);
            }
        }
        if (all(lessThan(wmax - wmin, vec3(0.5 / 255.0)))) {
            row_of[ty][tx] = -1.0;
            continue;
        }
        vec3 abd = vec3(0.0);
        vec4 g;
        float gx, gy;
        g = grad[ty + 1][tx + 1];
        gx = g.x;
        gy = g.z;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.047921588;
        g = grad[ty + 2][tx + 1];
        gx = g.x;
        gy = g.w;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.061533412;
        g = grad[ty + 3][tx + 1];
        gx = g.x;
        gy = g.w;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.061533412;
        g = grad[ty + 4][tx + 1];
        gx = g.x;
        gy = g.z;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.047921588;
        g = grad[ty + 1][tx + 2];
        gx = g.y;
        gy = g.z;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.061533412;
        g = grad[ty + 2][tx + 2];
        gx = g.y;
        gy = g.w;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.079011588;
        g = grad[ty + 3][tx + 2];
        gx = g.y;
        gy = g.w;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.079011588;
        g = grad[ty + 4][tx + 2];
        gx = g.y;
        gy = g.z;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.061533412;
        g = grad[ty + 1][tx + 3];
        gx = g.y;
        gy = g.z;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.061533412;
        g = grad[ty + 2][tx + 3];
        gx = g.y;
        gy = g.w;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.079011588;
        g = grad[ty + 3][tx + 3];
        gx = g.y;
        gy = g.w;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.079011588;
        g = grad[ty + 4][tx + 3];
        gx = g.y;
        gy = g.z;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.061533412;
        g = grad[ty + 1][tx + 4];
        gx = g.x;
        gy = g.z;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.047921588;
        g = grad[ty + 2][tx + 4];
        gx = g.x;
        gy = g.w;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.061533412;
        g = grad[ty + 3][tx + 4];
        gx = g.x;
        gy = g.w;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.061533412;
        g = grad[ty + 4][tx + 4];
        gx = g.x;
        gy = g.z;
        abd += vec3(gx * gx, gx * gy, gy * gy) * 0.047921588;
        float a = abd.x, b = abd.y, d = abd.z;
        float T = a + d, D = a * d - b * b;
        float delta = sqrt(max(T * T / 4.0 - D, 0.0));
        float L1 = T / 2.0 + delta, L2 = T / 2.0 - delta;
        float sqrtL1 = sqrt(L1), sqrtL2 = sqrt(max(L2, 0.0));
        float theta = mix(mod(atan(L1 - a, b) + 3.141592653589793, 3.141592653589793), 0.0, abs(b) < 1.192092896e-7);
        float lambda = sqrtL1;
        float mu = mix((sqrtL1 - sqrtL2) / (sqrtL1 + sqrtL2), 0.0, sqrtL1 + sqrtL2 < 1.192092896e-7);
        float angle = floor(theta * 24.0 / 3.141592653589793);
        float strength = mix(mix(0.0, 1.0, lambda >= 0.004), mix(2.0, 3.0, lambda >= 0.05), lambda >= 0.016);
        float coherence = mix(mix(0.0, 1.0, mu >= 0.25), 2.0, mu >= 0.5);
        row_of[ty][tx] = ((angle * 4.0 + strength) * 3.0 + coherence) / 288.0;
    }
    barrier();

    ivec2 o = tile0 + ivec2(gl_LocalInvocationID.xy);
    if (any(greaterThanEqual(o, ivec2(pc.out_size)))) {
        return;
    }
    vec2 pos = (vec2(o) + 0.5) * pc.size / pc.out_size;
    vec2 sub = fract(pos - 0.5);
    ivec2 t = ivec2(floor(pos - 0.5)) - b0;
    float coord_y = row_of[t.y][t.x];
    if (coord_y < 0.0) {
        imageStore(dst, o, vec4(rgb[t.y + 2][t.x + 2], 1.0));
        return;
    }
    vec2 phase = mix(vec2(0.5 / 9.0), vec2(1.0 - 0.5 / 9.0), sub);
    vec2 phase_inv = 1.0 - phase;
    vec2 subpix = phase / vec2(5.0, 288.0);
    vec2 subpix_inv = phase_inv / vec2(5.0, 288.0);
    vec2 subpix_ar = phase / vec2(2.0, 288.0);
    vec2 subpix_inv_ar = phase_inv / vec2(2.0, 288.0);
    vec3 res = vec3(0.0);
    vec4 w, wi;
    w = texture(lut, vec2(0.0, coord_y) + subpix);
    wi = texture(lut, vec2(0.0, coord_y) + subpix_inv);
    res += rgb[t.y + 0][t.x + 0] * w.x + rgb[t.y + 5][t.x + 5] * wi.x;
    res += rgb[t.y + 1][t.x + 0] * w.y + rgb[t.y + 4][t.x + 5] * wi.y;
    res += rgb[t.y + 2][t.x + 0] * w.z + rgb[t.y + 3][t.x + 5] * wi.z;
    res += rgb[t.y + 3][t.x + 0] * w.w + rgb[t.y + 2][t.x + 5] * wi.w;
    w = texture(lut, vec2(0.2, coord_y) + subpix);
    wi = texture(lut, vec2(0.2, coord_y) + subpix_inv);
    res += rgb[t.y + 4][t.x + 0] * w.x + rgb[t.y + 1][t.x + 5] * wi.x;
    res += rgb[t.y + 5][t.x + 0] * w.y + rgb[t.y + 0][t.x + 5] * wi.y;
    res += rgb[t.y + 0][t.x + 1] * w.z + rgb[t.y + 5][t.x + 4] * wi.z;
    res += rgb[t.y + 1][t.x + 1] * w.w + rgb[t.y + 4][t.x + 4] * wi.w;
    w = texture(lut, vec2(0.4, coord_y) + subpix);
    wi = texture(lut, vec2(0.4, coord_y) + subpix_inv);
    res += rgb[t.y + 2][t.x + 1] * w.x + rgb[t.y + 3][t.x + 4] * wi.x;
    res += rgb[t.y + 3][t.x + 1] * w.y + rgb[t.y + 2][t.x + 4] * wi.y;
    res += rgb[t.y + 4][t.x + 1] * w.z + rgb[t.y + 1][t.x + 4] * wi.z;
    res += rgb[t.y + 5][t.x + 1] * w.w + rgb[t.y + 0][t.x + 4] * wi.w;
    w = texture(lut, vec2(0.6, coord_y) + subpix);
    wi = texture(lut, vec2(0.6, coord_y) + subpix_inv);
    res += rgb[t.y + 0][t.x + 2] * w.x + rgb[t.y + 5][t.x + 3] * wi.x;
    res += rgb[t.y + 1][t.x + 2] * w.y + rgb[t.y + 4][t.x + 3] * wi.y;
    res += rgb[t.y + 2][t.x + 2] * w.z + rgb[t.y + 3][t.x + 3] * wi.z;
    res += rgb[t.y + 3][t.x + 2] * w.w + rgb[t.y + 2][t.x + 3] * wi.w;
    w = texture(lut, vec2(0.8, coord_y) + subpix);
    wi = texture(lut, vec2(0.8, coord_y) + subpix_inv);
    res += rgb[t.y + 4][t.x + 2] * w.x + rgb[t.y + 1][t.x + 3] * wi.x;
    res += rgb[t.y + 5][t.x + 2] * w.y + rgb[t.y + 0][t.x + 3] * wi.y;
    vec3 hi1 = vec3(0.0), lo1 = vec3(0.0), hi2 = vec3(0.0), lo2 = vec3(0.0);
    vec3 s, up, dn, up32, dn32;
    w = texture(lut_ar, vec2(0.0, coord_y) + subpix_ar);
    s = rgb[t.y + 1][t.x + 1];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.x;
    lo1 += dn32 * w.x;
    hi2 += up32 * up * w.x;
    lo2 += dn32 * dn * w.x;
    s = rgb[t.y + 2][t.x + 1];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.y;
    lo1 += dn32 * w.y;
    hi2 += up32 * up * w.y;
    lo2 += dn32 * dn * w.y;
    s = rgb[t.y + 3][t.x + 1];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.z;
    lo1 += dn32 * w.z;
    hi2 += up32 * up * w.z;
    lo2 += dn32 * dn * w.z;
    s = rgb[t.y + 4][t.x + 1];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.w;
    lo1 += dn32 * w.w;
    hi2 += up32 * up * w.w;
    lo2 += dn32 * dn * w.w;
    w = texture(lut_ar, vec2(0.5, coord_y) + subpix_ar);
    s = rgb[t.y + 1][t.x + 2];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.x;
    lo1 += dn32 * w.x;
    hi2 += up32 * up * w.x;
    lo2 += dn32 * dn * w.x;
    s = rgb[t.y + 2][t.x + 2];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.y;
    lo1 += dn32 * w.y;
    hi2 += up32 * up * w.y;
    lo2 += dn32 * dn * w.y;
    s = rgb[t.y + 3][t.x + 2];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.z;
    lo1 += dn32 * w.z;
    hi2 += up32 * up * w.z;
    lo2 += dn32 * dn * w.z;
    s = rgb[t.y + 4][t.x + 2];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.w;
    lo1 += dn32 * w.w;
    hi2 += up32 * up * w.w;
    lo2 += dn32 * dn * w.w;
    w = texture(lut_ar, vec2(0.0, coord_y) + subpix_inv_ar);
    s = rgb[t.y + 4][t.x + 4];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.x;
    lo1 += dn32 * w.x;
    hi2 += up32 * up * w.x;
    lo2 += dn32 * dn * w.x;
    s = rgb[t.y + 3][t.x + 4];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.y;
    lo1 += dn32 * w.y;
    hi2 += up32 * up * w.y;
    lo2 += dn32 * dn * w.y;
    s = rgb[t.y + 2][t.x + 4];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.z;
    lo1 += dn32 * w.z;
    hi2 += up32 * up * w.z;
    lo2 += dn32 * dn * w.z;
    s = rgb[t.y + 1][t.x + 4];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.w;
    lo1 += dn32 * w.w;
    hi2 += up32 * up * w.w;
    lo2 += dn32 * dn * w.w;
    w = texture(lut_ar, vec2(0.5, coord_y) + subpix_inv_ar);
    s = rgb[t.y + 4][t.x + 3];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.x;
    lo1 += dn32 * w.x;
    hi2 += up32 * up * w.x;
    lo2 += dn32 * dn * w.x;
    s = rgb[t.y + 3][t.x + 3];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.y;
    lo1 += dn32 * w.y;
    hi2 += up32 * up * w.y;
    lo2 += dn32 * dn * w.y;
    s = rgb[t.y + 2][t.x + 3];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.z;
    lo1 += dn32 * w.z;
    hi2 += up32 * up * w.z;
    lo2 += dn32 * dn * w.z;
    s = rgb[t.y + 1][t.x + 3];
    up = 0.1 + s;
    dn = 1.1 - s;
    up32 = up * up; up32 *= up32; up32 *= up32; up32 *= up32; up32 *= up32;
    dn32 = dn * dn; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32; dn32 *= dn32;
    hi1 += up32 * w.w;
    lo1 += dn32 * w.w;
    hi2 += up32 * up * w.w;
    lo2 += dn32 * dn * w.w;
    res = mix(res, clamp(res, 1.1 - lo2 / lo1, hi2 / hi1 - 0.1), 0.8);
    imageStore(dst, o, vec4(res, 1.0));
}
